 254   3              }
 255   2          }
 256   1      }
 257          
 258          /*
 259           * 生成不规则音符掉落时间表
 260           * 每条轨道15个音符，在34000ms音乐结束前全部掉落完毕
 261           * 使用多种扰动因子确保4条轨道音符不会整齐划一地下落
 262           */
 263          static void notes_build_schedule(void)
 264          {
 265   1          unsigned char track, note;
 266   1          unsigned int interval;
 267   1          unsigned int start_time;
 268   1      
 269   1          interval = MUSIC_LEN_MS / NOTES_PER_TRACK;  /* ~2266ms */
 270   1      
 271   1          for (track = 0; track < TRACK_COUNT; track++)
 272   1          {
 273   2              unsigned int offset = (unsigned int)track * 500U;
 274   2      
 275   2              for (note = 0; note < NOTES_PER_TRACK; note++)
 276   2              {
 277   3                  start_time = 800U
 278   3                             + (unsigned int)note * interval
 279   3                             + offset
 280   3                             + (unsigned int)(note % 3U) * 150U
 281   3                             + (unsigned int)((note * 37U) % 200U);
 282   3      
 283   3                  /* 确保最后一个音符在音乐结束前掉落完 */
 284   3                  if (start_time > MUSIC_LEN_MS - 2500U)
 285   3                  {
 286   4                      start_time = MUSIC_LEN_MS - 2500U
 287   4                                 - (unsigned int)(NOTES_PER_TRACK - note) * 100U;
 288   4                  }
 289   3      
 290   3                  /* 避免负数/过小值 */
 291   3                  if (start_time < 100U)
 292   3                  {
 293   4                      start_time = 100U + note * 80U;
 294   4                  }
 295   3      
 296   3                  g_note_start[track][note] = start_time;
 297   3                  g_note_state[track][note] = NOTE_PENDING;
 298   3              }
 299   2          }
 300   1      }
