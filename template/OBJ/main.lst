 430          /* 游戏结束: 统计结果 → 写底层变量图标触发界面转换 → 跳转成功/失败页 */
 431          static void game_end(void)
 432          {
 433   1          unsigned char success;
 434   1          unsigned char target_page;
 435   1      
 436   1          g_game_status = STATUS_ENDED;
 437   1          vp_write16(VP_GAME_STATUS, STATUS_ENDED);
