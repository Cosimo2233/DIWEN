 535   2              /* 离开游戏界面 → 清理 */
 536   2              if (g_game_status == STATUS_PLAYING)
 537   2              {
 538   3                  g_game_status = STATUS_IDLE;
 539   3                  audio_stop();
 540   3                  convert_reset();
 541   3              }
 542   2          }
 543   1      }
