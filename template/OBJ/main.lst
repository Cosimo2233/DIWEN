 318          
 319          /* 更新4条轨道的音符Y坐标 → 写入SP+4地址 → 屏幕上的音符往下掉 */
 320          static void game_update_notes(void)
 321          {
 322   1          unsigned char track, note;
 323   1      
 324   1          for (track = 0; track < TRACK_COUNT; track++)
 325   1          {
 326   2              unsigned char found_active = 0U;
 327   2      
 328   2              for (note = 0; note < NOTES_PER_TRACK; note++)
 329   2              {
 330   3                  /* 激活到达预定时间的音符 */
 331   3                  if (g_note_state[track][note] == NOTE_PENDING
 332   3                      && g_timer >= g_note_start[track][note])
 333   3                  {
 334   4                      g_note_state[track][note] = NOTE_FALLING;
 335   4                  }
 336   3      
 337   3                  /* 处理正在下落的音符 */
 338   3                  if (g_note_state[track][note] == NOTE_FALLING)
 339   3                  {
 340   4                      unsigned int elapsed = g_timer - g_note_start[track][note];
 341   4                      unsigned int y = NOTE_START_Y + elapsed / FALL_DIV;
 342   4      
 343   4                      if (y >= NOTE_END_Y)
 344   4                      {
 345   5                          /* 超出底部 → 漏掉 */
 346   5                          g_note_state[track][note] = NOTE_DONE;
 347   5                          g_note_y[track] = NOTE_HIDDEN_Y;
 348   5                      }
 349   4                      else
 350   4                      {
 351   5                          g_note_y[track] = y;
 352   5                          found_active = 1U;
 353   5                      }
 354   4      
 355   4                      /* ★ 核心衔接点: 写SP+4地址 → DGUS变量图标Y坐标变化 → 屏幕刷新 *
             -/
 356   4                      vp_write16(get_note_y_addr(track), g_note_y[track]);
 357   4                      break;  /* 每条轨道同时只有1个活跃音符 */
 358   4                  }
 359   3              }
 360   2      
 361   2              if (found_active == 0U)
 362   2              {
 363   3                  vp_write16(get_note_y_addr(track), NOTE_HIDDEN_Y);
C51 COMPILER V9.54   MAIN                                                                  06/05/2026 19:17:46 PAGE 7   

 364   3              }
 365   2          }
 366   1      }
