 454   2              target_page = success ? PAGE_SUCCESS_6 : PAGE_FAIL_7;
 455   2          }
 456   1          else
 457   1          {
 458   2              target_page = success ? PAGE_SUCCESS_9 : PAGE_FAIL_10;
 459   2          }
