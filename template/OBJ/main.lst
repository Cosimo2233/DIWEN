 368          /* 检测击中: 读底部4个返回控件VP → 判断Y坐标是否在命中区 */
 369          static void game_check_hits(void)
 370          {
 371   1          unsigned char track, note;
 372   1          unsigned int btn_val;
 373   1      
 374   1          for (track = 0; track < TRACK_COUNT; track++)
 375   1          {
 376   2              btn_val = vp_read16(get_hit_btn_addr(track));
 377   2      
 378   2              if (btn_val == 0U)
 379   2              {
 380   3                  continue;
 381   3              }
 382   2      
 383   2              /* 按钮被按下 */
 384   2              {
 385   3                  unsigned char hit_handled = 0U;
 386   3      
 387   3                  for (note = 0; note < NOTES_PER_TRACK; note++)
 388   3                  {
 389   4                      if (g_note_state[track][note] == NOTE_FALLING)
 390   4                      {
 391   5                          if (g_note_y[track] >= HIT_Y_MIN && g_note_y[track] <= HIT_Y_MAX)
 392   5                          {
 393   6                              /* ★ 命中! */
 394   6                              g_hit_count++;
 395   6                              g_note_state[track][note] = NOTE_DONE;
 396   6                              g_note_y[track] = NOTE_HIDDEN_Y;
 397   6                              vp_write16(get_note_y_addr(track), NOTE_HIDDEN_Y);
 398   6                              vp_write16(VP_JUDGE_RESULT, JUDGE_HIT);
 399   6                          }
 400   5                          else
 401   5                          {
 402   6                              /* 时机不对 → 失误 */
 403   6                              vp_write16(VP_JUDGE_RESULT, JUDGE_MISS);
 404   6                          }
 405   5                          hit_handled = 1U;
 406   5                          break;
 407   5                      }
 408   4                  }
 409   3      
 410   3                  if (hit_handled == 0U)
 411   3                  {
 412   4                      /* 无活跃音符时误触 */
 413   4                      vp_write16(VP_JUDGE_RESULT, JUDGE_MISS);
 414   4                  }
 415   3              }
 416   2      
 417   2              /* 清空按钮状态，等待下次按下 */
 418   2              vp_write16(get_hit_btn_addr(track), 0U);
 419   2          }
 420   1      }
